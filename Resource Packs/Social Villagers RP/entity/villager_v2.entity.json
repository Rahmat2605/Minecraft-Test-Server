      "geometry": {
        "default": "geometry.villager_v2",
        "baby": "geometry.villager.baby",
        "fmc_face": "geometry.fmc_villager_face",
        "fmc_face_baby": "geometry.fmc_villager_face_baby"
      },
      "scripts": {
        "scale": "query.is_baby ? 2.0 : 0.9375",
        "pre_animation": [
          "variable.num_professions = 15;",
          "variable.num_tiers = 3;",
          "variable.profession_index = (query.variant < variable.num_professions ? query.variant : 0);",
          "variable.level_index = query.trade_tier;",
          "variable.fmc_base = query.is_sleeping ? 5 : query.property('fmc:face');",
          "variable.fmc_talk = query.property('fmc:talking') && math.mod(query.life_time * 5 + variable.fmc_seed, 1) < 0.55;",
          "variable.fmc_blink = variable.fmc_base == 0 && !variable.fmc_talk && math.mod(query.life_time + variable.fmc_seed, 4.3) < 0.14;",
          "variable.fmc_face = variable.fmc_blink ? 10 : variable.fmc_base * 2 + (variable.fmc_talk ? 1 : 0);"
        ],
        "initialize": [
          "variable.fmc_seed = math.random(0, 6);"
        ],
        "animate": [
          "ctrl_general",
          "ctrl_move",
          "ctrl_raise_arms",
          {
            "fmc_breathe": "query.modified_move_speed < 0.1 && !query.is_sleeping"
          },
          {
            "fmc_walk_bob": "query.modified_move_speed >= 0.1 && !query.is_sleeping"
          }
        ]
      },
      "animations": {
        "general": "animation.villager.general",
        "look_at_target": "animation.common.look_at_target",
        "move": "animation.villager.move",
        "raise_arms": "animation.villager.raise_arms",
