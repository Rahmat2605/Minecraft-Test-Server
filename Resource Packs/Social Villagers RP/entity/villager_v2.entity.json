        "ctrl_raise_arms": "controller.animation.villager_v2.raise_arms",
        "fmc_breathe": "animation.fmc.villager.breathe",
        "fmc_walk_bob": "animation.fmc.villager.walk_bob"
      },
      "render_controllers": [
        "controller.render.villager_v3_base",
        "controller.render.villager_v3_masked",
        "controller.render.villager_v3_level",
        {
          "controller.render.fmc_villager_face": "variable.fmc_face > 0"
        }
