{
	"namespace": "hud",
	"hud_actionbar_text": {
		"type": "image",
		"$size|default": [
			"100%c + 12px",
			"100%c + 5px"
		],
		"$offset|default": [
			0,
			"50%-68px"
		],
		"offset": "$offset",
		"size": "$size",
		"$d|default": "text_background_opacity",
		"$e|default": "textures/ui/hud_tip_text_background",
		"anchor_from": "center",
		"anchor_to": "center",
		"$atext": "$actionbar_text",
		"texture": "$e",
		"alpha": "$d",
		"variables": [
			{
				"requires": "(not (($atext - '§R§M§U') = $atext))",
				"$offset": [
					0,
					"40%-68px"
				]
			},
			{
				"requires": "(not (($atext - '§R§M§U') = $atext))",
				"$d": 1
			},
			{
				"requires": "(not (($atext - '§R§M§U') = $atext))",
				"$size": [
					"100%c + 20px",
					"100%c + 14px"
				]
			},
			{
				"requires": "(not (($atext - '§R§E§D') = $atext))",
				"$e": "textures/ui/redBorder"
			},
			{
				"requires": "(not (($atext - '§G§R§E') = $atext))",
				"$e": "textures/ui/greenBorder"
			},
			{
				"requires": "(not (($atext - '§O§R§A') = $atext))",
				"$e": "textures/ui/orangeBorder"
			},
			{
				"requires": "(not (($atext - '§G§R§A') = $atext))",
				"$e": "textures/ui/greyBorder"
			}
		],
		"controls": [
			{
				"actionbar_message": {
					"type": "label",
					"$font_size|default": "normal",
					"variables": [
						{
							"requires": "(not (($atext - '§R§M§U') = $atext))",
							"$font_size": "large"
						}
					],
					"font_size": "$font_size",
					"anchor_from": "center",
					"anchor_to": "center",
					"color": "$tool_tip_text",
					"layer": 999,
					"text": "$actionbar_text",
					"localize": true,
					"alpha": "@hud.anim_actionbar_text_alpha_out"
				}
			}
		]
	},
	"hud_screen": {
		"render_only_when_topmost": false,
		"$additional_screen_content": "hud.notification_factory",
		"$use_loading_bars": false,
		"$screen_animations": [],
		"$background_animations": []
	},
	"notification_factory": {
		"type": "stack_panel",
		"size": [
			0,
			"100%c"
		],
		"layer": 20,
		"anchor_from": "top_right",
		"anchor_to": "top_right",
		"factory": {
			"name": "chat_item_factory",
			"control_ids": {
				"chat_item": "@hud.notification"
			}
		}
	},
	"noti_1": {
		"anim_type": "size",
		"duration": "$in_time",
		"easing": "out_sine",
		"from": [
			"100%c",
			"100%c"
		],
		"to": [
			0,
			"100%c"
		],
		"next": "@hud.noti_2"
	},
	"noti_2": {
		"anim_type": "wait",
		"duration": "$stay_time",
		"next": "@hud.noti_3"
	},
	"noti_3": {
		"anim_type": "size",
		"duration": "$out_time",
		"easing": "in_sine",
		"from": [
			0,
			"100%c"
		],
		"to": [
			"100%c",
			"100%c"
		],
		"next": "@hud.noti_4"
	},
	"noti_4": {
		"anim_type": "alpha",
		"duration": 0,
		"from": 1,
		"to": 0,
		"next": "@hud.noti_5"
	},
	"noti_5": {
		"anim_type": "size",
		"duration": 1,
		"easing": "out_expo",
		"from": [
			"100%c",
			"100%c"
		],
		"to": [
			"100%c",
			0
		],
		"next": "@hud.noti_4",
		"destroy_at_end": "chat_grid_item"
	},
	"immediate_destroy_anim": {
		"anim_type": "wait",
		"duration": 0,
		"destroy_at_end": "chat_grid_item"
	},
	"notification": {
		"$in_time": 1,
		"$stay_time": 5,
		"$out_time": 1,
		"type": "panel",
		"propagate_alpha": true,
		"anims": [
			"@hud.noti_1"
		],
		"controls": [
			{
				"notification_background": {
					"type": "image",
					"anchor_from": "top_right",
					"anchor_to": "top_right",
					"size": [
						"100%c + 18px",
						"100%cm + 12px"
					],
					"min_size": [
						"100%c + 18px",
						34
					],
					"controls": [
						{
							"notification_text_panel": {
								"type": "panel",
								"size": [
									"100%cm",
									"100%c"
								],
								"layer": 1,
								"anchor_from": "right_middle",
								"anchor_to": "right_middle",
								"offset": [
									-9,
									1
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "notification_background",
										"source_property_name": "#notification_title",
										"target_property_name": "#nested_title",
										"resolve_sibling_scope": true
									},
									{
										"binding_type": "view",
										"source_control_name": "notification_background",
										"source_property_name": "#notification_message",
										"target_property_name": "#nested_message",
										"resolve_sibling_scope": true
									}
								],
								"controls": [
									{
										"notification_title": {
											"type": "label",
											"line_padding": -2,
											"font_type": "MinecraftTen",
											"backup_font_type": "MinecraftTen",
											"font_scale_factor": 1.5,
											"text": "#title",
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"offset": [
												0,
												-2
											],
											"max_size": [
												200,
												"default"
											],
											"bindings": [
												{
													"binding_type": "view",
													"source_control_name": "notification_text_panel",
													"source_property_name": "#nested_title",
													"target_property_name": "#title",
													"resolve_sibling_scope": true
												},
												{
													"binding_type": "view",
													"source_property_name": "(not (#title = '§r§r'))",
													"target_property_name": "#visible"
												}
											]
										}
									},
									{
										"notification_message": {
											"type": "label",
											"line_padding": 1,
											"text": "#message",
											"anchor_from": "bottom_left",
											"anchor_to": "bottom_left",
											"max_size": [
												200,
												"default"
											],
											"bindings": [
												{
													"binding_type": "view",
													"source_control_name": "notification_text_panel",
													"source_property_name": "#nested_message",
													"target_property_name": "#message",
													"resolve_sibling_scope": true
												},
												{
													"binding_type": "view",
													"source_property_name": "(not (#message = '§r§r'))",
													"target_property_name": "#visible"
												}
											]
										}
									}
								]
							}
						},
						{
							"notification_icon_texture": {
								"type": "image",
								"layer": 1,
								"size": [
									16,
									16
								],
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"offset": [
									9,
									9
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "notification_background",
										"source_property_name": "#notification_icon_texture",
										"target_property_name": "#texture",
										"resolve_sibling_scope": true
									},
									{
										"binding_type": "view",
										"source_property_name": "(not (#texture = '') and (#texture - 'aux:' = #texture))",
										"target_property_name": "#visible"
									}
								]
							}
						},
						{
							"notification_item_renderer": {
								"type": "custom",
								"renderer": "inventory_item_renderer",
								"layer": 1,
								"size": [
									16,
									16
								],
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"offset": [
									9,
									9
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "notification_background",
										"source_property_name": "((#notification_icon_texture - 'aux:') * 1)",
										"target_property_name": "#item_id_aux",
										"resolve_sibling_scope": true
									},
									{
										"binding_type": "view",
										"source_control_name": "notification_background",
										"source_property_name": "(not (#notification_icon_texture - 'aux:' = #notification_icon_texture))",
										"target_property_name": "#visible",
										"resolve_sibling_scope": true
									}
								]
							}
						},
						{
							"notification_icon_padding": {
								"type": "panel",
								"size": [
									6,
									0
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "notification_background",
										"source_property_name": "(not ((#notification_title + #notification_message = '§r§r§r§r') or (#notification_icon_texture = '')))",
										"target_property_name": "#visible",
										"resolve_sibling_scope": true
									}
								]
							}
						}
					],
					"bindings": [
						{
							"binding_type": "view",
							"source_property_name": "(not (('§␛' + #text + '§r') - ('§␛' + $notification_flag_0e34fd) = ('§␛' + #text + '§r')))",
							"target_property_name": "#visible"
						},
						{
							"binding_type": "view",
							"source_property_name": "('\b' + #text - $notification_flag_0e34fd)",
							"target_property_name": "#data"
						},
						{
							"binding_type": "view",
							"source_property_name": "('§r' + '%.101s' * #data - '\b' - '\t' + '§r')",
							"target_property_name": "#notification_title"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('§r' + '%.301s' * #data - '%.101s' * #data) - '\b' - '\t' + '§r')",
							"target_property_name": "#notification_message"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.401s' * #data - '%.301s' * #data - '\t')",
							"target_property_name": "#notification_icon_texture"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.501s' * #data - '%.401s' * #data - '\t')",
							"target_property_name": "#texture"
						}
					]
				}
			},
			{
				"immediate_destroy": {
					"type": "stack_panel",
					"size": [
						0,
						0
					],
					"factory": {
						"name": "immediate_destroy_factory",
						"control_name": "@hud.immediate_destroy_control"
					},
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "notification_background",
							"source_property_name": "((not #visible) * 1)",
							"target_property_name": "#collection_length",
							"resolve_sibling_scope": true
						}
					]
				}
			}
		]
	},
	"immediate_destroy_control": {
		"type": "panel",
		"size": [
			0,
			0
		],
		"anims": [
			"@hud.immediate_destroy_anim"
		]
	},
	"chat_grid_item/chat_background": {
		"bindings": [
			{
				"binding_type": "view",
				"source_property_name": "(('§␛' + #text + '§r') - ('§␛' + $notification_flag_0e34fd) = ('§␛' + #text + '§r'))",
				"target_property_name": "#visible"
			}
		]
	}
}